{
  "input_dimension": 3333,
  "window_duration_seconds": 10.0,
  "sampling_rate_hz": 333.3333,
  "preprocessing_filter": "butterworth_0.8_3.0hz_zero_phase_order3",
  "kan_hyperparameters": {
    "latent_dim": 16,
    "hidden_dim": 8,
    "output_dim": 1,
    "grid_size": 5,
    "spline_order": 3,
    "grid_range": [
      -2.0,
      2.0
    ],
    "base_activation": "silu"
  },
  "training_hyperparameters": {
    "optimizer": "adam",
    "learning_rate": 0.001,
    "loss_function": "huber",
    "huber_delta": 1.0,
    "batch_size": 16,
    "max_epochs": 30,
    "early_stopping_patience": 7,
    "lr_reduction_patience": 3
  },
  "evaluation_protocol": {
    "strategy": "Leave-One-Subject-Out (LOSO)",
    "total_folds": 24,
    "metrics": [
      "MAE",
      "RMSE",
      "Pearson_r",
      "within_3bpm_pct",
      "within_5bpm_pct"
    ]
  }
}